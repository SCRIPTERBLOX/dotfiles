{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "height": 10,
    "color": { "2": "blue", "1": "light_blue" },
    "padding": {
      "top": 1,
      "right": 6,
      "left": 1
    }
  },
  "modules": [
    "break",
    {
	"type": "custom",
	"format": "┌──────────────┐",
	"outputColor": "blue"
    },
    {
      "type": "command",
      "key": "│ OS",
      "keyColor": "blue",
      "outputColor": "blue",
      "text": "echo \"Arch btw │\""
    },
    {
      "type": "custom",
      "format": "└──────────────┘",
      "outputColor": "blue"
    },
    "break",
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
      "key": "┌",
      //"showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "└",
      "keyColor": "green"
    },
    "break",
    {
      "type": "kernel",
      "key": "┌",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "├",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "├",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "├󰏖",
      "keyColor": "blue"
    },
    /*{
      "type": "wmtheme",
      "key": "├󰉼",
      "keyColor": "blue"
    },*/
    {
      "type": "terminalfont",
      "key": "└",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "command",
      "key": "┌󱦟 OS Age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "└󱫐 Uptime",
      "keyColor": "magenta"
    },
    "break"
  ]
}
